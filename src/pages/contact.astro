---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import site from '../data/site.json';
import headers from '../data/headers.json';
const h = headers.contact;
---
<Base title={h.seoTitle} description={h.seoDescription || undefined}>
  <PageHero eyebrow={h.eyebrow} title={h.title} intro={h.intro} />
  <section>
    <div class="wrap">
      <div class="grid-3">
        <div class="contact-card">
          <h3>{site.labels.shortName}</h3>
          <p class="muted">{site.legalName}</p>
          <p style="margin-top:12px"><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        {site.contacts.map((c) => (
          <div class="contact-card">
            <span class="eyebrow">{c.role}</span>
            <h3 style="margin-top:6px">{c.name}</h3>
            <p class="muted">{c.location}</p>
            <p style="margin-top:12px"><a href={`mailto:${c.email}`}>{c.email}</a></p>
          </div>
        ))}
      </div>
      <div class="grid-3" style="margin-top:24px">
        {site.offices.map((o) => (
          <div class="contact-card">
            <h3>{o.name}</h3>
            <p class="muted" style="white-space:pre-line">{o.address}</p>
            <p style="margin-top:12px"><a href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(o.address.replace(/\n/g, ', '))}`} target="_blank" rel="noopener">{site.labels.openMap}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
