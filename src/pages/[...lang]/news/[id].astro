---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import FileList from '../../../components/FileList.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { fmtLong } from '../../../lib';
import { localize, t, tr, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const items = await getCollection('news', (n) => !n.data.draft);
  return items.flatMap((item) => [undefined, 'pt'].map((lang) => ({ params: { lang, id: item.id }, props: { item } })));
}
const lang: Lang = Astro.params.lang === 'pt' ? 'pt' : 'en';
const T = t(lang);
const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
const event = d.event ? await getEntry('events', d.event) : undefined;
// Say when the article is in the other language than the page.
const note = d.language === 'PT' && lang === 'en' ? T.inPortuguese : d.language === 'EN' && lang === 'pt' ? T.inEnglish : '';
---
<Base title={d.title} description={d.summary} image={d.image}>
  <PageHero eyebrow={fmtLong(d.date, lang)} title={d.title} crumbs={[{ href: localize('/news/', lang), label: T.news }]}>
    {d.source && <p style="margin-top:6px">{T.source} {d.source}{note}</p>}
  </PageHero>
  <section>
    <div class="wrap narrow">
      {d.image && <img src={d.image} alt={d.imageAlt ?? ''} style="border-radius:14px;margin-bottom:28px" />}
      {d.summary && <p class="lead" style="margin-bottom:24px">{d.summary}</p>}
      <div class="prose"><Content /></div>
      {d.documents.length > 0 && (<><h3 style="margin:36px 0 14px">{T.documents}</h3><FileList files={d.documents} /></>)}
      {d.links.length > 0 && (
        <>
          <h3 style="margin:36px 0 14px">{T.linksTitle}</h3>
          <div class="files">
            {d.links.map((l) => <a class="file" href={localize(l.url, lang)} target="_blank" rel="noopener"><span class="ext">↗</span><span><strong>{l.label}</strong><small>{T.externalLink}</small></span></a>)}
          </div>
        </>
      )}
      {event && <p style="margin-top:36px">{T.relatedEvent} <a style="color:var(--green);font-weight:600" href={localize(`/events/${event.id}/`, lang)}>{tr(event.data, 'shortTitle', lang)}</a></p>}
      <p style="margin-top:40px"><a href={localize('/news/', lang)} class="btn btn-ghost" style="color:var(--green)">{T.allNews}</a></p>
    </div>
  </section>
</Base>
