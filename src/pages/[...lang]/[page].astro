---
/** Simple text pages from src/content/pages (PT: src/content/pages-pt): privacy, cookies, legal notice. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { render } from 'astro:content';
import { fmtLong } from '../../lib';
import { t, type Lang } from '../../i18n';
import { getPage } from '../../texts';

export function getStaticPaths() {
  return ['privacy', 'cookies', 'legal-notice'].flatMap((page) => [{ params: { lang: undefined, page } }, { params: { lang: 'pt', page } }]);
}
const lang: Lang = Astro.params.lang === 'pt' ? 'pt' : 'en';
const entry = await getPage(Astro.params.page!, lang);
const { Content } = await render(entry);
---
<Base title={entry.data.title}>
  <PageHero title={entry.data.title} intro={entry.data.updated ? `${t(lang).lastUpdated} ${fmtLong(entry.data.updated, lang)}` : undefined} />
  <section><div class="wrap narrow prose"><Content /></div></section>
</Base>
