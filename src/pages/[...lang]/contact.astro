---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import site from '../../data/site.json';
import { headersData, langPaths, tr, type Lang } from '../../i18n';

export function getStaticPaths() { return langPaths(); }
const lang: Lang = Astro.params.lang === 'pt' ? 'pt' : 'en';
const h = headersData(lang).contact ?? {};
const s = site as any;
const labels = s.labels ?? {};
---
<Base title={h.seoTitle} description={h.seoDescription || undefined}>
  <PageHero eyebrow={h.eyebrow} title={h.title} intro={h.intro} />
  <section>
    <div class="wrap">
      <div class="grid-3">
        <div class="contact-card">
          <h3>{tr(labels, 'shortName', lang) || site.name}</h3>
          <p class="muted">{tr(s, 'legalName', lang)}</p>
          <p style="margin-top:12px"><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        {(s.contacts ?? []).map((c: any) => (
          <div class="contact-card">
            <span class="eyebrow">{tr(c, 'role', lang)}</span>
            <h3 style="margin-top:6px">{c.name}</h3>
            <p class="muted">{c.location}</p>
            <p style="margin-top:12px"><a href={`mailto:${c.email}`}>{c.email}</a></p>
          </div>
        ))}
      </div>
      <div class="grid-3" style="margin-top:24px">
        {(s.offices ?? []).map((o: any) => (
          <div class="contact-card">
            <h3>{tr(o, 'name', lang)}</h3>
            <p class="muted" style="white-space:pre-line">{o.address}</p>
            <p style="margin-top:12px"><a href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(o.address.replace(/\n/g, ', '))}`} target="_blank" rel="noopener">{tr(labels, 'openMap', lang)}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
