---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import headers from '../../data/headers.json';
const h = headers.news;

const items = (await getCollection('news', (n) => !n.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(items.map((n) => n.data.date.getUTCFullYear()))];
---
<Base title={h.seoTitle} description={h.seoDescription || undefined}>
  <PageHero eyebrow={h.eyebrow} title={h.title} intro={h.intro} />
  <section>
    <div class="wrap">
      <div class="chips" style="margin-bottom:32px">
        {years.map((y) => <a class="chip" href={`#y${y}`}>{y}</a>)}
      </div>
      {years.map((y) => (
        <div id={`y${y}`} style="margin-bottom:48px">
          <h2 style="font-size:1.4rem">{y}</h2>
          <div class="grid-3">
            {items.filter((n) => n.data.date.getUTCFullYear() === y).map((n) => (
              <NewsCard item={n} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
