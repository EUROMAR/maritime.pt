---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getEntry, render } from 'astro:content';
import site from '../data/site.json';

const page = (await getEntry('pages', 'membership'))!;
const { Content } = await render(page);
const m = site.membership ?? ({} as any);
const raw = (m.applyUrl ?? '').trim();
// Accept "www.example.com" as well as full links
const applyUrl = !raw ? `mailto:${site.email}` : /^(https?:|mailto:|\/)/.test(raw) ? raw : `https://${raw}`;
const external = /^https?:/.test(applyUrl);
---
<Base title="Become a member" description="Join EISAP – the Shipping Association of Portugal.">
  <PageHero eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} />
  <section>
    <div class="wrap grid-2">
      <div class="prose"><Content /></div>
      {site.statutesPdf && (
        <div class="pillars">
          <a class="file" href={site.statutesPdf} target="_blank" rel="noopener"><span class="ext">pdf</span><span><strong>{site.labels.statutesTitle}</strong><small>{site.labels.statutesNote}</small></span></a>
        </div>
      )}
    </div>
  </section>
  <section id="apply" class="section-alt">
    <div class="wrap narrow" style="text-align:center">
      {m.applyText && <p class="muted" style="margin-bottom:24px;font-size:1.1rem">{m.applyText}</p>}
      <a class="btn btn-primary apply-btn" href={applyUrl} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{m.applyLabel || 'Apply for membership'}</a>
    </div>
  </section>
</Base>
