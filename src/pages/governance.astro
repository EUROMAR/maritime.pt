---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import { getCollection, render } from 'astro:content';

const all = (await getCollection('board', (b) => b.data.active)).sort((a, b) => a.data.order - b.data.order);
const groups = ['Board of Directors', 'General Assembly', 'Fiscal Council', 'Honorary'] as const;
const rendered = await Promise.all(all.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<Base title="Governance" description="Board of Directors, General Assembly and Fiscal Council of EISAP.">
  <PageHero eyebrow="Governance" title="Board & governing bodies" intro="EISAP is led by shipowners and maritime professionals from across Europe." />
  {groups.map((g, i) => {
    const people = rendered.filter((r) => r.p.data.group === g);
    return people.length > 0 && (
      <section class={i % 2 ? 'section-alt' : ''} id={g.toLowerCase().replace(/\s+/g, '-')}>
        <div class="wrap">
          <h2>{g === 'Honorary' ? 'Honorary Board Member' : g}</h2>
          <div class="grid-4" style="margin-top:24px">
            {people.map(({ p, Content }) => (
              <PersonCard name={p.data.name} role={p.data.role} meta={[p.data.company, p.data.city].filter(Boolean).join(' · ')} photo={p.data.photo} bio>
                <Content />
              </PersonCard>
            ))}
          </div>
        </div>
      </section>
    );
  })}
</Base>
