---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import { getCollection, render } from 'astro:content';
import { getPeople } from '../people';
import headers from '../data/headers.json';
const h = headers.governance;

const all = await getPeople();
const rendered = await Promise.all(all.map(async (p) => ({ p, Content: (await render(p)).Content })));
const sections = await Promise.all(
  (await getCollection('governance', (s) => s.data.show))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
    .map(async (s) => ({
      s,
      people: rendered.filter((r) => r.p.data.group === s.id),
      Note: (s.body ?? '').trim() ? (await render(s)).Content : null,
    })),
);
const visible = sections.filter((x) => x.people.length > 0 || x.Note);
---
<Base title={h.seoTitle} description={h.seoDescription || undefined}>
  <PageHero eyebrow={h.eyebrow} title={h.title} intro={h.intro} />
  {visible.map(({ s, people, Note }, i) => (
    <section class={i % 2 ? 'section-alt' : ''} id={s.id}>
      <div class="wrap">
        <h2>{s.data.title}</h2>
        {people.length > 0 && (
          <div class="grid-4" style="margin-top:24px">
            {people.map(({ p, Content }) => (
              <PersonCard name={p.data.name} role={p.data.role} meta={[p.data.company, p.data.city].filter(Boolean).join(' · ')} photo={p.data.photo} bio>
                <Content />
              </PersonCard>
            ))}
          </div>
        )}
        {Note && <div class="prose" style="margin-top:24px"><Note /></div>}
      </div>
    </section>
  ))}
</Base>
