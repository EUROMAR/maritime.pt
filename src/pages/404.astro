---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import headers from '../data/headers.json';
const h = headers.notFound;
---
<Base title={h.seoTitle} noindex>
  <PageHero eyebrow={h.eyebrow} title={h.title} intro={h.intro} />
  <section><div class="wrap ctas"><a class="btn btn-green" href="/">Back to home</a><a class="btn btn-ghost" style="color:var(--green)" href="/news/">Latest news</a></div></section>
</Base>
