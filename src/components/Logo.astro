---
interface Props { light?: boolean }
const { light = false } = Astro.props;
const c = light ? '#FFFFFF' : '#0E5A2E';
---
<svg viewBox="0 0 520 180" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Maritime Portugal – EISAP Shipping Association of Portugal">
  <rect x="0" y="10" width="12" height="130" fill={light ? '#FFFFFF' : '#0E5A2E'} />
  <rect x="20" y="10" width="24" height="130" fill="#A91B1F" />
  <text x="62" y="66" font-family="Arial,Helvetica,sans-serif" font-size="58" fill={c} letter-spacing="15">MARITIME</text>
  <text x="62" y="138" font-family="Arial,Helvetica,sans-serif" font-size="58" fill={c} letter-spacing="15">PORTUGAL</text>
  <text x="62" y="174" font-family="Arial,Helvetica,sans-serif" font-size="19.5" fill={c} letter-spacing="2.2">EISAP - Shipping Association of Portugal</text>
</svg>
