---
import site from '../data/site.json';
import nav from '../data/navigation.json';
import { href } from '../links';
const year = new Date().getFullYear();
const footer = nav.footer ?? ({} as any);
const columns = (footer.columns ?? []).filter((c: any) => c?.title || c?.links?.length);
const legal = (footer.legal ?? []).filter((l: any) => l?.label);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div>
        <h4>{footer.addressTitle || site.name}</h4>
        <p>{site.legalName}</p>
        {site.offices.slice(0, 1).map((o) => <p style="margin-top:10px;white-space:pre-line">{o.address}</p>)}
        <p style="margin-top:12px"><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      {columns.map((c: any) => (
        <div>
          {c.title && <h4>{c.title}</h4>}
          <ul>
            {(c.links ?? []).filter((l: any) => l?.label).map((l: any) => <li><a href={href(l.link)}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="legal">
      <span>© {year} {site.name}</span>
      <div>{legal.map((l: any) => <a href={href(l.link)}>{l.label}</a>)}</div>
    </div>
  </div>
</footer>
