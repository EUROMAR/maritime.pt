---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div>
        <h4>EISAP</h4>
        <p>{site.legalName}</p>
        {site.offices.slice(0, 1).map((o) => <p style="margin-top:10px;white-space:pre-line">{o.address}</p>)}
        <p style="margin-top:12px"><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div>
        <h4>Association</h4>
        <ul>
          <li><a href="/about/">Who we are</a></li>
          <li><a href="/about/#objectives">Objectives</a></li>
          <li><a href="/governance/">Governance</a></li>
          <li><a href={site.statutesPdf}>Statutes (PDF)</a></li>
        </ul>
      </div>
      <div>
        <h4>Activity</h4>
        <ul>
          <li><a href="/events/">Annual meetings</a></li>
          <li><a href="/news/">News &amp; press</a></li>
        </ul>
      </div>
      <div>
        <h4>Members</h4>
        <ul>
          <li><a href="/membership/">Become a member</a></li>
          <li><a href="/members/">Members area (coming soon)</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {site.name}</span>
      <div><a href="/privacy/">Privacy policy</a><a href="/cookies/">Cookie policy</a><a href="/legal-notice/">Legal notice</a></div>
    </div>
  </div>
</footer>
