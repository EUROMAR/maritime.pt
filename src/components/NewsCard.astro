---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../lib';
interface Props { item: CollectionEntry<'news'> }
const { item } = Astro.props;
const d = item.data;
---
<a class="card" href={`/news/${item.id}/`}>
  {d.image && <div class="thumb"><img src={d.image} alt={d.imageAlt ?? ''} loading="lazy" /></div>}
  <div class="body">
    <div class="meta"><span class="tag">{d.type}</span><span>{fmtDate(d.date)}</span>{d.source && d.type !== 'Press release' && <span>{d.source}</span>}{d.language === 'PT' && <span>PT</span>}</div>
    <h3>{d.title}</h3>
    {d.summary && <p>{d.summary}</p>}
    <span class="more">Read more →</span>
  </div>
</a>
