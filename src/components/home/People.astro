---
import PersonCard from '../PersonCard.astro';
import Buttons from './Buttons.astro';
import { getPeople } from '../../people';
const { s } = Astro.props;
const count = Number(s.count) || 0;
const all = await getPeople(s.group || 'Board of Directors');
const people = count > 0 ? all.slice(0, count) : all;
---
{people.length > 0 && (
  <section class={Astro.props.alt ? 'section-alt' : undefined}>
    <div class="wrap">
      <div class="head-row">
        <div>{s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}{s.title && <h2 style="margin-bottom:0">{s.title}</h2>}</div>
        <Buttons buttons={s.button ? [s.button] : []} light as="fragment" />
      </div>
      <div class="grid-4">
        {people.map((p) => <PersonCard name={p.data.name} role={p.data.role} meta={[p.data.company, p.data.city?.split(',')[0]].filter(Boolean).join(', ')} photo={p.data.photo} />)}
      </div>
    </div>
  </section>
)}
