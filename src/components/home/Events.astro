---
import { getCollection } from 'astro:content';
import { dateRange } from '../../lib';
const { s } = Astro.props;

const all = (await getCollection('events', (e) => !e.data.draft)).sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
// "featured" holds the CMS reference (e.g. src/content/events/mmw-2025.md); empty = most recent event.
const featuredId = String(s.featured ?? '').split('/').pop()?.replace(/\.md$/, '');
const latest = (featuredId && all.find((e) => e.id === featuredId)) || all[0];
const pastCount = Number(s.pastCount) || 0;
const others = all.filter((e) => e !== latest);
const past = pastCount > 0 ? others.slice(0, pastCount) : others;
const isUpcoming = latest && latest.data.startDate > new Date();
const label = (v: unknown, d: string) => (typeof v === 'string' && v.trim() ? v : d);
// Timeline: every edition, oldest first; the ship sails along it as the page scrolls.
const timeline = [...all].reverse();
const stopName = (t: string) => t.replace(/\s*\d{4}$/, '');
// On phones only the first edition and the featured/latest one are shown on the timeline.
const keep = (e: any, i: number) => i === 0 || i === timeline.length - 1 || e === latest;
const hidden = timeline.filter((e, i) => !keep(e, i)).length;
const d = latest?.data;
const facts = latest ? [
  d.conference.length > 0 && `${label(s.programmeLabel, 'Conference programme')}${d.speakers.length ? ` & ${d.speakers.length} ${label(s.speakersLabel, 'speakers')}` : ''}`,
  d.presentations.length > 0 && label(s.presentationsLabel, 'Presentations available for download'),
  label(s.galleryLabel, ''),
].filter(Boolean) : [];
---

{latest && (
  <section class={`ev-sec${Astro.props.alt ? ' section-alt' : ''}`} id="events">
    <div class="wrap">
      {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
      {s.title && <h2>{s.title}</h2>}
      {s.text && <p class="lead">{s.text}</p>}
      {timeline.length > 1 && (
        <div class="voy" aria-label="Timeline of annual meetings">
          <div class="voy-track">
            {timeline.map((e, i) => <i class={keep(e, i) ? undefined : 'mid'} style={`left:${(i / timeline.length) * 100}%`}></i>)}
            <svg class="voy-ship" viewBox="0 0 48 30" aria-hidden="true">
              <path d="M2 19h44l-4.5 8.5H7.5Z" fill="currentColor" />
              <path d="M4 9h6v9H4zM5.5 5.5h2.5V9H5.5z" fill="currentColor" />
              <g fill="currentColor">
                <rect x="12" y="13.6" width="5.6" height="4.6" rx=".4" /><rect x="18.3" y="13.6" width="5.6" height="4.6" rx=".4" /><rect x="24.6" y="13.6" width="5.6" height="4.6" rx=".4" /><rect x="30.9" y="13.6" width="5.6" height="4.6" rx=".4" /><rect x="37.2" y="13.6" width="5.6" height="4.6" rx=".4" />
                <rect x="12" y="8.4" width="5.6" height="4.6" rx=".4" opacity=".8" /><rect x="18.3" y="8.4" width="5.6" height="4.6" rx=".4" opacity=".55" /><rect x="24.6" y="8.4" width="5.6" height="4.6" rx=".4" opacity=".8" /><rect x="30.9" y="8.4" width="5.6" height="4.6" rx=".4" opacity=".55" />
                <rect x="18.3" y="3.2" width="5.6" height="4.6" rx=".4" opacity=".55" /><rect x="24.6" y="3.2" width="5.6" height="4.6" rx=".4" opacity=".8" />
              </g>
              <path d="M5 8.2V3.8" stroke="currentColor" stroke-width="1" />
            </svg>
          </div>
          <div class="voy-stops">
            {timeline.map((e, i) => (
              <>
                {i === timeline.length - 1 && hidden > 0 && <a class="voy-more" href="/events/">+{hidden} more</a>}
                <a class={`voy-stop${e === latest ? ' hi' : ''}${keep(e, i) ? '' : ' mid'}`} href={`/events/${e.id}/`}>
                  <span class="yr">{e.data.startDate.getUTCFullYear()}</span>
                  <span class="tx">{stopName(e.data.shortTitle)}<br />{e.data.location}</span>
                  {e === latest && <span class="pill">{isUpcoming ? label(s.upcomingLabel, 'Next event') : label(s.latestLabel, 'Latest edition')}</span>}
                </a>
              </>
            ))}
          </div>
        </div>
      )}

      <article class="ev">
        <a class="ev-media" href={`/events/${latest.id}/`} tabindex="-1" aria-hidden="true">
          {d.heroImage ? (
            <>
              <img class="ev-bg" src={d.heroImage} alt="" loading="lazy" />
              <img class="ev-img" src={d.heroImage} alt={d.heroImageAlt ?? ''} loading="lazy" />
            </>
          ) : <span class="ev-mark">{latest.data.shortTitle}</span>}
          <span class="ev-date"><b>{d.startDate.getUTCDate()}{d.endDate && d.endDate.getUTCMonth() === d.startDate.getUTCMonth() && d.endDate.getUTCDate() !== d.startDate.getUTCDate() ? `–${d.endDate.getUTCDate()}` : ''}</b>{d.startDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</span>
        </a>
        <div class="ev-body">
          <span class="pill">{isUpcoming ? label(s.upcomingLabel, 'Next event') : label(s.latestLabel, 'Latest edition')}</span>
          <h3><a href={`/events/${latest.id}/`}>{d.title}</a></h3>
          <p class="when">{dateRange(d.startDate, d.endDate)} · {d.location}</p>
          {d.edition && <p class="edition">{d.edition}</p>}
          <p class="sum">{d.summary}</p>
          {facts.length > 0 && <ul>{facts.map((f) => <li>{f}</li>)}</ul>}
          <div class="ctas">
            <a href={`/events/${latest.id}/`} class="btn btn-primary">{label(s.buttonLabel, 'Explore')} {d.shortTitle}</a>
            {isUpcoming && d.registrationUrl && <a href={d.registrationUrl} class="btn btn-ghost">Register</a>}
            <a href="/events/" class="btn btn-ghost">All events</a>
          </div>
        </div>
      </article>
    </div>
  </section>
)}

<script>
  // Moves the container ship along the timeline while the section scrolls into view.
  const voys = document.querySelectorAll<HTMLElement>('.voy');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  voys.forEach((v) => v.classList.add('js'));
  const update = () => voys.forEach((v) => {
    const r = v.getBoundingClientRect();
    const vh = innerHeight;
    const p = reduce ? 1 : Math.min(1, Math.max(0, (vh * 0.9 - r.top) / (vh * 0.6)));
    v.style.setProperty('--p', p.toFixed(4));
    // A stop lights up once the ship reaches it (works for the desktop and phone layouts).
    const w = v.clientWidth || 1;
    const marks = v.querySelectorAll('.voy-track i');
    const stops = v.querySelectorAll<HTMLElement>('.voy-stop');
    stops.forEach((s, i) => {
      const on = p >= (i === stops.length - 1 ? 0.95 : s.offsetLeft / w);
      s.classList.toggle('reached', on);
      marks[i]?.classList.toggle('reached', on);
    });
  });
  let ticking = false;
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>
