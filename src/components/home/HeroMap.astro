---
<div class="hmap" aria-hidden="true">
  <img class="hmap-base" src="/images/world-map.svg" alt="" width="1440" height="701" decoding="async" />
  <svg class="hmap-lanes" width="1440" height="701" viewBox="0 0 1440 701">
    {lanes.map((d, i) => <path class="lane" data-i={i} d={d} />)}
    <g class="compass" transform="translate(1046 548)">
      <circle r="30" /><circle r="22" />
      <path d="M0-40L5-5L40 0L5 5L0 40L-5 5L-40 0L-5-5Z" class="cr" />
      <path d="M0-40L5-5L0 0ZM40 0L5 5L0 0ZM0 40L-5 5L0 0ZM-40 0L-5-5L0 0Z" class="cr-dark" />
      <text y="-46">N</text>
    </g>
  </svg>
  {vessels.map((v) => (
    <div class={`v${v.rev ? ' rev' : ''}`} data-i={v.lane - 1}
      style={`offset-path:path('${lanes[v.lane - 1]}');width:${Math.round(v.w * 0.6)}px;animation-duration:${v.dur * 2.2}s;animation-delay:${v.delay * 2.2}s`}></div>
  ))}
  <span class="ring" style={`left:${hub.x}px;top:${hub.y}px`}></span>
  <span class="ring" style={`left:${hub.x}px;top:${hub.y}px;animation-delay:3s`}></span>
  {ports.map((p) => (
    <>
      <span class="pdot" data-lanes={p.lanes.join(' ')} style={`left:${p.x}px;top:${p.y}px`}></span>
      <span class={`pl${p.on ? ' on' : ''}`} style={`left:${p.x}px;top:${p.y}px;transform:translate(${p.left ? 'calc(-100% - 10px)' : '10px'},-50%)`}>{p.name}</span>
    </>
  ))}
  <span class="pdot hubdot" data-lanes={lanes.map((_, i) => i).filter((i) => lanes[i].startsWith('M755')).join(' ')} style={`left:${hub.x}px;top:${hub.y}px`}></span>
  <span class="pl hubl" style={`left:${hub.x}px;top:${hub.y}px;transform:translate(14px,-120%)`}>{hub.name}</span>
</div>

<script>
  // Hovering a port highlights the lanes that call there.
  const map = document.querySelector<HTMLElement>('.hmap');
  map?.querySelectorAll<HTMLElement>('.pdot').forEach((dot) => {
    const ids = (dot.dataset.lanes ?? '').split(' ').filter(Boolean);
    if (!ids.length) return;
    dot.addEventListener('mouseenter', () => {
      map.classList.add('focus');
      ids.forEach((i) => map.querySelectorAll(`[data-i="${i}"]`).forEach((el) => el.classList.add('hi')));
    });
    dot.addEventListener('mouseleave', () => {
      map.classList.remove('focus');
      map.querySelectorAll('.hi').forEach((el) => el.classList.remove('hi'));
    });
  });
</script>

<style>
  .hmap{position:absolute;left:clamp(-700px,calc(100% - 1180px),300px);top:40px;width:1440px;height:701px;z-index:0;
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 8%,#000 92%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 8%,#000 92%,transparent 100%)}
  .hmap-base,.hmap-lanes{position:absolute;left:0;top:0;max-width:none}
  .lane{fill:none;stroke:#EADFC4;stroke-opacity:.35;stroke-width:1;stroke-dasharray:3 5;transition:stroke-opacity .4s,stroke-width .4s}
  .focus .lane{stroke-opacity:.12}
  .focus .lane.hi{stroke-opacity:.9;stroke-width:1.5}
  .compass circle{fill:none;stroke:#EADFC4;stroke-opacity:.18}
  .compass .cr{fill:#EADFC4;fill-opacity:.14}
  .compass .cr-dark{fill:#EADFC4;fill-opacity:.22}
  .compass text{fill:#EADFC4;fill-opacity:.4;font:600 11px Georgia,'Times New Roman',serif;text-anchor:middle}
  .v{position:absolute;left:0;top:0;height:2px;border-radius:2px;offset-rotate:auto;offset-anchor:100% 50%;
    animation:sail linear infinite;background:linear-gradient(90deg,transparent,rgba(234,223,196,.55));transition:opacity .4s}
  .v::after{content:"";position:absolute;right:-2px;top:-2px;width:6px;height:6px;border-radius:50%;background:#F4ECD8}
  .v.rev{animation-name:sailr;offset-rotate:auto 180deg}
  .focus .v{opacity:.25}
  .focus .v.hi{opacity:1}
  @keyframes sail{from{offset-distance:0%}to{offset-distance:100%}}
  @keyframes sailr{from{offset-distance:100%}to{offset-distance:0%}}
  .pdot{position:absolute;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;background:#F4ECD8;opacity:.8;cursor:default;z-index:2}
  .pdot::after{content:"";position:absolute;inset:-10px;border-radius:50%}
  .pl{position:absolute;font:italic 500 12px/1 Georgia,'Times New Roman',serif;letter-spacing:.08em;color:#C9D8CC;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .25s;z-index:2}
  .pl.on{opacity:.75}
  .pdot:hover{opacity:1;transform:scale(1.4)}
  .pdot:hover + .pl{opacity:1;color:#fff}
  .hubdot{width:12px;height:12px;margin:-6px 0 0 -6px;background:var(--red);border:2px solid #F4ECD8;opacity:1}
  .hubl{opacity:1;font:600 14px/1 Georgia,'Times New Roman',serif;font-style:normal;letter-spacing:.2em;color:#F4ECD8}
  .ring{position:absolute;width:20px;height:20px;margin:-10px 0 0 -10px;border-radius:50%;border:1px solid #EADFC4;opacity:0;animation:ping 6s ease-out infinite}
  @keyframes ping{0%{transform:scale(.6);opacity:.6}100%{transform:scale(7);opacity:0}}
  @media (prefers-reduced-motion:reduce){.v,.ring{animation:none}.v{display:none}}
  @media (max-width:760px){.hmap{opacity:.55}.pl{display:none}}
</style>
